# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой — написать боту /id)
ADMIN_IDS=

DB_PATH=data/birthdays.db
TZ_NAME=Asia/Yekaterinburg

# Расписание (местное время)
MORNING_TIME=09:00     # напоминания менеджерам + черновики поздравлений для HR
POST_TIME=10:00        # публикация поздравлений сотрудникам в группе
ESCALATE_TIME=18:00    # кто из партнёров сегодня не отмечен «поздравил» — админам
DIGEST_WEEKDAY=0       # сводка на неделю: 0 = понедельник

# Claude API (console.anthropic.com). Пусто = поздравления по шаблонам.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Anthropic не обслуживает запросы из РФ. Если сервер в России — укажите прокси за рубежом:
# ANTHROPIC_PROXY=http://user:pass@host:port
ANTHROPIC_PROXY=

INVITE_TTL_DAYS=7
